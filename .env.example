# Supabase 연결 정보 (없으면 같은 브라우저 탭끼리만 통신하는 로컬 모드로 동작)
# Supabase 대시보드 → Project Settings → API 에서 복사
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# (선택) WebRTC TURN 서버 — 음성이 까다로운 NAT/방화벽에서 안 될 때 안정화.
# 예: Twilio Network Traversal Service, 자체 coturn. 없으면 STUN만 사용.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# (선택) 이미지 업로드용 Supabase Storage 버킷 이름. 비우면 dataURL 직접 전송.
VITE_SUPABASE_BUCKET=

# AI 봇(Groq) — 운영은 Vercel 환경변수 GROQ_API_KEY(서버 전용, 비노출) 권장:
#   Vercel 프로젝트 Settings → Environment Variables → GROQ_API_KEY
# 로컬 개발 시에만 아래로 직접 호출(브라우저 노출되니 운영엔 쓰지 말 것):
VITE_GROQ_API_KEY=
